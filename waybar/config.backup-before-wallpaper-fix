{
    "layer": "top",
    "position": "top",
    "height": 48,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "custom/wallpaper", "cava", "custom/prev", "custom/playpause", "custom/next"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/airpods", "pulseaudio", "backlight", "cpu", "memory", "custom/orbit", "battery", "custom/lock"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "urgent": "",
            "active": "",
            "default": ""
        }
    },

    "tray": {
        "icon-size": 24,
        "spacing": 2
    },

    "custom/launcher": {
        "format": "",
        "on-click": "wofi --show drun",
        "on-click-right": "killall rofi",
        "tooltip": false
    },

    "custom/airpods": {
        "exec": "python3 /home/amine/.config/waybar/airpods.py 34:0E:22:47:89:48",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "connected": "󱡒",
            "disconnected": "󱡑",
            "connecting": "󱘖"
        },
        "on-click": "pkill -USR1 -f 'airpods\\.py'",
        "tooltip": true,
        "exec-on-event": false,
        "output": "DP-2",
        "restart-interval": 5
    },

    "custom/orbit": {
        "exec": "orbit waybar-status",
        "return-type": "json",
        "interval": 10,
        "on-click": "orbit toggle top-right",
        "format": "󰀸"
    },

    "clock": {
        "timezone": "Africa/Casablanca",
        "format": "  {:%I:%M %p}",
        "tooltip-format": "  {:%d/%m/%Y}"
    },

    "cava": {
        "framerate": 240,
        "autosens": 0,
        "sensitivity": 9,
        "bars": 8,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": false,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": true,
        "waves": true,
        "noise_reduction": 0.9,
        "input_delay": 0.5,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    "backlight": {
        "device": "intel_backlight",
        "rotate": 0,
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-click": "brightnessctl -r",
        "on-scroll-up": "brightnessctl set 2%+",
        "on-scroll-down": "brightnessctl set 2%-",
        "min-length": 6
    },

    "bluetooth": {
        "controller": "blueberry",
        "format": "",
        "format-disabled": "",
        "format-off": " off",
        "on-click": "blueberry",
        "on-click-right": "blueberry"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "custom/lock": {
        "tooltip": false,
        "on-click": "wlogout -b 6 -T 450 -B 450 -L 500 -R 500",
        "on-click-right": "killall rofi",
        "format": "⏻"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "{profile}",
        "tooltip": true,
        "format-icons": {
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },

    "custom/power": {
        "tooltip": false,
        "on-click": "wlogout",
        "on-click-right": "killall rofi",
        "format": "⏻ "
    },

    "hyprland/language": {
        "format": "  {short}"
    },

    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-disconnected": "",
        "format-wifi": "  {essid}",
        "tooltip-format": "{signalStrength}%",
        "tooltip-format-wifi": "{essid} {signalStrength}%",
        "tooltip-format-disconnected": "No Connection",
        "on-click": "networkmanager_dmenu",
        "on-click-right": "nm-connection-manager"
    },

    "custom/prev": {
        "format": "⏮",
        "on-click": "playerctl --player=playerctld previous"
    },

    "custom/playpause": {
        "exec": "playerctl --player=playerctld status 2>/dev/null | grep -q Playing && echo '' || echo ''",
        "interval": 1,
        "return-type": "text",
        "on-click": "playerctl --player=playerctld play-pause"
    },

    "custom/next": {
        "format": "⏭",
        "on-click": "playerctl --player=playerctld next"
    },

    "cpu": {
        "format": "󰇺 {usage}%",
        "tooltip": true,
        "tooltip-format": "CPU usage: {usage}%\nCPU temp: {temperatureC}°C",
        
    },

    "memory": {
        "format": "󰏗 {percentage}%",
        "tooltip": true
    },

    "custom/wallpaper": {
        "format": "",
        "tooltip": false,
        "on-click": "/home/amine/.config/hypr/scripts/wallpaper.sh"
    }
}